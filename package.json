{
  "name": "dsh-typst-plugin",
  "version": "0.1.0",
  "description": "Typst plugin for DeepSeek Harness: a live preview right-sidebar panel driven by the user's own typst, with agent tools that check errors, look at rendered pages, point at places in the preview, and export PDFs.",
  "icon": "./docs/images/icon.png",
  "keywords": [
    "typst",
    "dsh",
    "deepseek-harness",
    "plugin",
    "preview",
    "pdf",
    "typesetting"
  ],
  "author": "Wenjie Xu <wenjie.xu.cn@outlook.com>",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.5"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/images/icon.png",
    "docs/plugin-detail.md",
    "docs/plugin-detail.en.md",
    "locale",
    "README.md",
    "README.en.md",
    "release-provenance.json"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-file-upload"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-attachment": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-file-upload": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-resources": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-native-command": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-output-retention": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-timeout": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-working-directory": ">=0.2.2-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "^1.9.0",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "^3.19.0",
    "clsx": "^2.1.1",
    "pdfjs-dist": "6.3.289",
    "zod": "4.6.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vncntvx/dsh-typst.git"
  },
  "bugs": {
    "url": "https://github.com/Vncntvx/dsh-typst/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
