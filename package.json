{
  "name": "dsh-typst-plugin",
  "version": "0.1.0-alpha.0",
  "description": "Typst plugin for DeepSeek Harness: a live preview right-sidebar panel driven by the user's own typst, with agent tools that check errors, look at rendered pages, point at places in the preview, and export PDFs.",
  "icon": "./docs/images/icon.png",
  "keywords": [
    "typst",
    "dsh",
    "deepseek-harness",
    "plugin",
    "preview",
    "pdf",
    "typesetting"
  ],
  "author": "Wenjie Xu <wenjie.xu.cn@outlook.com>",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/images/icon.png",
    "docs/plugin-detail.md",
    "docs/plugin-detail.en.md",
    "locale",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "dev:client": "node scripts/build-client.mjs --watch",
    "typecheck": "node scripts/harness-state.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.client-test.json --noEmit",
    "test": "node scripts/test-lint.mjs && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:test": "node scripts/test-lint.mjs",
    "style:check": "node scripts/style-guard.mjs",
    "tokens:check": "node scripts/style-tokens.mjs",
    "tokens:write": "node scripts/style-tokens.mjs --write",
    "harness:check": "node scripts/harness-state.mjs",
    "harness:pin": "node scripts/harness-state.mjs --write",
    "deps:check": "node scripts/deps-check.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "prepare": "node scripts/build-prepare.mjs",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run format:check && node scripts/harness-state.mjs --strict && npm run lint:test && npm run style:check && npm run typecheck && npm run test:coverage && npm run build && npm run verify:pack",
    "release:branch": "node scripts/publish-release-branch.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:discovery": "node scripts/discovery-smoke.mjs",
    "smoke:web-composition": "node scripts/discovery-smoke.mjs --browser",
    "link:local-harness": "node scripts/link-local-harness.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-file-upload"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-file-upload": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-resources": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.1",
